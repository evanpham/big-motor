! Multi-pole segment of one phase (ring coil threading 40 C-cores); torque on the middle pole.
! Frame: motor axis = Z (sector.geo turns the Onshape parts), x = radial at the sector centre, y = tangential. Bodies: 1 core, 2 coil, 3 rotor, 4 air.
! BC 1: all outer faces, flux parallel (n x A = 0).
$ turns = 45
$ amps  = 36
$ coilA = 216e-6          ! coil cross-section [m2], set by run_sector.sh from the geometry
$ J0 = turns*amps/coilA   ! ring current density [A/m2]

Header
  Mesh DB "." "mesh"
  Results Directory "results"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 3D
  Simulation Type = Steady state
  Steady State Max Iterations = 1
End

Constants
  Permeability of Vacuum = 1.2566370614e-6
End

Body 1
  Name = "core"
  Equation = 1
  Material = 1
End
Body 2
  Name = "coil"
  Equation = 1
  Material = 3
  Body Force = 1
End
Body 3
  Name = "rotor"
  Equation = 1
  Material = 1
End
Body 4
  Name = "air"
  Equation = 1
  Material = 2
End
Body 5
  Name = "core_side"
  Equation = 1
  Material = 1
End
Body 6
  Name = "rotor_side"
  Equation = 1
  Material = 1
End

Material 1
  Name = "M19"
  H-B Curve = Variable "dummy"
    Real Cubic Monotone
      include "m19_bh.dat"
  End
  Electric Conductivity = 0.0
End
Material 2
  Name = "Air"
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End
Material 3
  Name = "Copper"
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

! azimuthal ring current around +Z: direction (-y, x, 0)/r
Body Force 1
  Current Density 1 = Variable Coordinate 1, Coordinate 2
    Real MATC "-J0*tx(1)/sqrt(tx(0)^2+tx(1)^2)"
  Current Density 2 = Variable Coordinate 1, Coordinate 2
    Real MATC "J0*tx(0)/sqrt(tx(0)^2+tx(1)^2)"
  Current Density 3 = Real 0.0
End

Component 1
  Name = "stator"
  Master Bodies(1) = 1
  Calculate Magnetic Force = Logical True
  Calculate Magnetic Torque = Logical True
  Torque Origin(3) = Real 0 0 0
  Torque Axis(3) = Real 0 0 1
End
Component 2
  Name = "rotor"
  Master Bodies(1) = 3
  Calculate Magnetic Force = Logical True
  Calculate Magnetic Torque = Logical True
  Torque Origin(3) = Real 0 0 0
  Torque Axis(3) = Real 0 0 1
End

Equation 1
  Active Solvers(2) = 1 2
End

Solver 1
  Equation = "MGDynamics"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Variable = "AV"
  Fix Input Current Density = True

  Nonlinear System Max Iterations = 40
  Nonlinear System Convergence Tolerance = 1e-6
  Nonlinear System Newton After Iterations = 4
  Nonlinear System Newton After Tolerance = 1e-3
  Nonlinear System Relaxation Factor = 1.0

  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStabl
  BiCGStabl Polynomial Degree = 4
  Linear System Preconditioning = None
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1e-9
  Linear System Abort Not Converged = False
  Linear System Residual Output = 50
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Magnetic Field Strength = True
  Calculate Magnetic Vector Potential = True
  Calculate Current Density = True
  Calculate Relative Permeability = True
  Calculate Nodal Forces = True
  Calculate Elemental Fields = True
  Calculate Nodal Fields = True
  Linear System Solver = Iterative
  Linear System Iterative Method = CG
  Linear System Preconditioning = ILU0
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1e-9
End

Solver 3
  Exec Solver = After Simulation
  Equation = "ResultOutput"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "case"
  Vtu Format = True
  Discontinuous Bodies = True
  Save Geometry Ids = True
End

Solver 4
  Exec Solver = After Simulation
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = "scalars.dat"
End

Boundary Condition 1
  Name = "outer"
  Target Boundaries(1) = 1
  AV {e} = Real 0.0
End
